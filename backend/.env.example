# Runtime
NODE_ENV=development
PORT=4000

# Allowed web applications
FRONTEND_ORIGIN=http://localhost:5173
BACKOFFICE_ORIGIN=http://localhost:5174

# PostgreSQL — intentionally configured without DATABASE_URL
PGHOST=localhost
PGPORT=5432
PGDATABASE=dhiki
PGUSER=postgres
PGPASSWORD=change_me
PGSSL=false
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=30000
PGCONNECTION_TIMEOUT_MS=2000

# Replace with a long random value outside development (32 characters minimum in production)
SESSION_SECRET=replace_with_a_long_random_secret

# Emails d'alerte (fenêtre Urgence) — sans SMTP_HOST, les alertes sont seulement journalisées
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DHIKI <no-reply@dhiki.space>
ALERTE_EMAIL=equipe@dhiki.space
